// --- FILE: nextflow.config ---
// Root Nextflow configuration for all OmicsBox DSL2 workflows.
// =================================================================

// ---------------------------------------------------
// DOCKER CONFIGURATION
// ---------------------------------------------------
docker {
    enabled    = false
    runOptions = '-u $(id -u):$(id -g)'
}

// ---------------------------------------------------
// GLOBAL PIPELINE PARAMETERS
// ---------------------------------------------------
params {
    pipeline      = null            // Pipeline selector: --pipeline <name> (loads its script + config)
    dump_config = false             // Flag to dump the configuration parameters to a file
    omicsboxImage = 'ubuntu:24.04'  // Docker image for OmicsBox tool execution
    local_folder  = './results'     // Base output directory for all workflow results
}

// ---------------------------------------------------
// PROCESS DEFAULTS
// ---------------------------------------------------
process {
    container = params.omicsboxImage
    publishDir = [
        path:      { "${params.local_folder}/${workflow.sessionId}" },
        mode:      'copy',
        overwrite: true
    ]
}

// ---------------------------------------------------
// PER-PIPELINE CONFIG (auto-loaded via --pipeline)
// El mismo --pipeline que elige el script en main.nf carga aquí su config.
// El parser estricto (v2) NO admite `if`: se usa un ternario (expresión).
// De momento solo functional_annotation; el resto -> empty.config (no-op).
// ---------------------------------------------------
//includeConfig params.pipeline == 'functional_annotation' ? 'workflows/functional_annotation/functional_annotation.config' : 'conf/empty.config'

includeConfig "workflows/${params.pipeline}/${params.pipeline}.config"
