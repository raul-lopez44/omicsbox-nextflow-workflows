// --- FILE: nextflow.config ---
// Root Nextflow configuration for all OmicsBox DSL2 workflows.
// =================================================================

manifest {
    name            = 'raul-lopez44/omicsbox-nextflow-workflows'
    author          = 'Raúl López'
    description     = 'OmicsBox Nextflow Workflows platform'
    // Default script acts as a help menu if no profile is selected
    mainScript      = 'main.nf'
}

profiles {
    
    // 1. De Novo Transcriptome Characterization
    de_novo_transcriptome {
        manifest.mainScript = 'workflows/de_novo_transcriptome_characterization/de_novo_transcriptome_characterization.nf'
        // includeConfig 'workflows/de_novo_transcriptome_characterization/de_novo_transcriptome_characterization.config'
    }
    
    // 2. Metagenomics Analysis
    metagenomics {
        manifest.mainScript = 'workflows/metagenomics_analysis/metagenomics_analysis.nf'
        // includeConfig 'workflows/metagenomics_analysis/metagenomics_analysis.config'
    }
    
    // 3. Functional Annotation (NEW)
    functional_annotation {
        manifest.mainScript = 'workflows/functional_annotation/functional_annotation.nf'
        // includeConfig 'workflows/functional_annotation/functional_annotation.config'
    }

}

// ---------------------------------------------------
// DOCKER CONFIGURATION
// ---------------------------------------------------
docker {
    enabled    = false
    runOptions = '-u $(id -u):$(id -g)'
}

// ---------------------------------------------------
// GLOBAL PIPELINE PARAMETERS
// ---------------------------------------------------
params {
    dump_config = false             // Flag to dump the configuration parameters to a file
    omicsboxImage = 'ubuntu:24.04'  // Docker image for OmicsBox tool execution
    local_folder  = './results'     // Base output directory for all workflow results
}

// ---------------------------------------------------
// PROCESS DEFAULTS
// ---------------------------------------------------
process {
    container = params.omicsboxImage
    publishDir = [
        path:      { "${params.local_folder}/${workflow.sessionId}" },
        mode:      'copy',
        overwrite: true
    ]
}

