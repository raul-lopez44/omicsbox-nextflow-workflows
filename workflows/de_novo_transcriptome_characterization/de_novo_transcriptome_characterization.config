// =============================================================================
// FILE: de_novo_transcriptome_characterization.config
// Configuration for De Novo Transcriptome Characterization pipeline
// =============================================================================

// -----------------------------------------------------------------------------
// Global parameters
// -----------------------------------------------------------------------------
params {

    // ── Input reads (provide exactly one) ──────────────────────────────────
    input_single_end = null   // Glob for SE reads, e.g. 'data/*.fastq.gz'
    input_paired_end = null   // Glob for PE reads, e.g. 'data/*_{1,2}.fastq.gz'

    local_folder   = './results'

    // ── Cloud storage (required for all WJOB_ASYNC tools) ──────────────────
    cloud_folder     = null   // e.g. 's3://my-bucket/omicsbox-outputs/'

    // ── Paired-end read filename patterns ──────────────────────────────────
    //upstream_pattern   = '_1'    // R1 filename pattern (e.g. '_1' → sample_1.fastq.gz)
    //downstream_pattern = '_2'    // R2 filename pattern (e.g. '_2' → sample_2.fastq.gz)

    // ── Global chart format (applies to all chart-generating tools) ─────────
    chart_format = 'box'         // Options: box | png | pdf | csv

     // ---------------------------------------------------
    // TRIMMOMATIC SPECIFIC PARAMETERS
    // ---------------------------------------------------
    trimmomatic {
        // FILES: Only paths/files are defined as parameters to allow channel staging
        // Provide the path to a custom fasta file, or leave as null
        adapters = null 
    }

    // ---------------------------------------------------
    // FASTQC SPECIFIC PARAMETERS
    // ---------------------------------------------------
    fastqc {
        // FILES: Optional custom adapter / contaminant FASTA files (OmicsBox searches defaults if null)
        adapters = null
        contaminants = null
    }
}

// -----------------------------------------------------------------------------
// Process-level configuration — one withName block per pipeline step
// =============================================================================

process {

    // ── 01 Raw FastQC ────────────────────────────────────────────────────────
    withName: 'FASTQC_RAW' {
        ext.outdir = '01_fastqc_raw'
        ext.args = [
            '--binning=true',   // Group bases in QC plots (recommended for reads >50 bp)
            // --keep-inputs-in-cloud  // Retain uploaded input files in the cloud after the run. Useful when chaining pipeline steps that reuse the same inputs.
        ].join(' ')
    }

    // ── 02 Trimmomatic preprocessing ─────────────────────────────────────────
    withName: 'TRIMMOMATIC' {
        ext.outdir = '02_trimmomatic'
        ext.args = [
            // ── General ──────────────────────────────────────────────────────
            '--quality-encoding=auto',               // [auto|phred33|phred64] Auto-detect encoding
            // '--prefix=trimmed_',                  // Output filename prefix

            // ── Adapter Removal ───────────────────────────────────────────────
            '--remove-adapters=false',               // Enable adapter/contaminant trimming
            // '--adapter-options=default',          // [default|custom] Only if remove-adapters=true
            // '--adapter-list=TruSeq3-SE.fa',       // [TruSeq3-SE.fa|TruSeq2-SE.fa|NexteraPE-PE.fa] Only if adapter-options=default
            // '--seed-mismatches=2',                // Max mismatches for full adapter match; only if remove-adapters=true
            // '--palindrome-clip-threshold=30',     // PE palindrome clip accuracy; only if remove-adapters=true
            // '--simple-clip-threshold=15',         // Simple adapter match accuracy; only if remove-adapters=true
            // '--min-adapter-length=8',             // Min detectable adapter length; only if remove-adapters=true
            // '--keep-both-reads=true',             // Retain reverse read after PE palindrome detection; only if remove-adapters=true

            // ── Edge Trimming ─────────────────────────────────────────────────
            '--edge-trimming=false',                 // Enable edge trimming
            // '--edge-trimming-options=qual',       // [qual|length] Only if edge-trimming=true
            // '--qual-trimming-from5p=true',        // Trim low-quality from 5'; only if edge-trimming-options=qual
            // '--normal-trimming-threshold5p=30',   // Min quality at 5'; only if qual-trimming-from5p=true
            // '--qual-trimming-from3p=true',        // Trim low-quality from 3'; only if edge-trimming-options=qual
            // '--normal-trimming-threshold3p=30',   // Min quality at 3'; only if qual-trimming-from3p=true
            // '--length-trimming-from5p=false',     // Crop N bases from 5'; only if edge-trimming-options=length
            // '--length-trimming-threshold5p-remove=3', // Bases to remove from 5'; only if length-trimming-from5p=true
            // '--length-trimming-from3p=false',     // Crop to fixed length from 3'; only if edge-trimming-options=length
            // '--length-trimming-threshold3p-keep=150', // Bases to keep from start; only if length-trimming-from3p=true

            // ── Quality Trimming ──────────────────────────────────────────────
            // '--quality-trimming=false',           // Enable sliding-window or maxinfo trimming
            // '--quality-trimming-options=sliding', // [sliding|maxinfo] Only if quality-trimming=true
            // '--window-size=4',                    // Sliding window width; only if quality-trimming-options=sliding
            // '--required-quality=15',              // Min avg quality in window; only if quality-trimming-options=sliding
            // '--target-length=40',                 // Target read length for maxinfo; only if quality-trimming-options=maxinfo
            // '--strictness=0.5',                   // [0..1] Length vs correctness tradeoff; only if quality-trimming-options=maxinfo

            // ── Read Filtering ────────────────────────────────────────────────
            '--filter-by-quality=true',           // Discard reads below avg quality
            '--average-quality=25',               // Min avg quality to retain a read; only if filter-by-quality=true
            '--filter-by-length=true',            // Discard reads below min length
            '--minimum-length=36',                // Min retained read length (bp); only if filter-by-length=true
        ].join(' ')
    }

    // ── 03 Post-trim FastQC ───────────────────────────────────────────────────
    withName: 'FASTQC_POST' {
        ext.outdir = '03_fastqc_post'
        ext.args = [
            '--binning=true',   // Group bases in QC plots
            // --keep-inputs-in-cloud   // Retain uploaded input files in the cloud after the run. Useful when chaining pipeline steps that reuse the same inputs.
        ].join(' ')
    }

    // ── 04 Trinity de-novo assembly ───────────────────────────────────────────
    withName: 'TRINITY' {
        ext.outdir = '04_trinity'
        ext.args = [
            // --sequencing is injected dynamically (Single/Paired) in the module
            '--seq-type=fq',                          // [fq|fa] Input read type
            '--strand-specificity=NO',              // [NO|F|R] Library strandedness
            '--min-contig-length=800',              // Min assembled contig length (bp); min 100
            '--get-read-representation=false',      // Align reads back to assembly with Bowtie2 (expensive)
            '--get-super-transcripts=false',        // Generate SuperTranscript collapsed gene models
            '--no-normalize-reads=false',           // false = use normalization (recommended for large data)
            '--norm-max-read-cov=200',              // Max read coverage after normalization; only if no-normalize-reads=false
            '--min-fused-transcripts=false',        // Minimise fusion transcripts (compact genomes only; expensive)
            // '--pairs-distance=500',              // Max PE fragment size (bp); only if sequencing=Paired
            '--min-kmer-cov=2',                     // Min k-mer coverage for Inchworm step; min 1
            '--max-reads-per-graph=200000',         // Max reads per Chrysalis de Bruijn graph; min 0
            '--min-glue=2',                         // Min reads to glue Inchworm contigs; min 0
            '--max-cluster-size=25',                // Max Inchworm contigs per Chrysalis cluster; min 0
            '--bfly-algorithm=ORIGINAL',            // [ORIGINAL|PASAFLY] Butterfly assembly algorithm
            '--path-reinforcement-dist=25',         // Min read overlap with growing transcript path
            '--no-path-merging=false',              // false = merge near-identical transcript paths
            '--min-per-id-same-path=98',            // Min % identity to merge paths [0-100]; only if no-path-merging=false
            '--max-diffs-same-path=2',              // Max base differences between merged paths; only if no-path-merging=false
            '--max-internal-gap-same-path=10',      // Max internal consecutive gaps in merged paths; only if no-path-merging=false
        ].join(' ')
    }

    // ── 05 CD-HIT clustering ──────────────────────────────────────────────────
    withName: 'CDHIT' {
        ext.outdir = '05_cdhit'
        ext.args = [
            '--sequence-identity-type=global',      // [global|local] Identity calculation basis
            '--sequence-identity=0.95',             // Identity threshold [0.8..1.0]
            '--band-width=20',                      // Alignment band width; min 1
            '--word-length=10',                     // Word size [2..11]; 10-11 for ≥0.95 identity
            '--length-cutoff=10',                   // Skip sequences shorter than this (bp); min 10
            '--length-difference-cutoff=0.0',       // Min length ratio of shorter to representative [0..1]
            '--accurate-mode=false',                // true = cluster into most similar (slow); false = first-match (fast)
            '--strand=true',                        // true = both +/+ and +/- alignments; false = +/+ only
            '--set-alignment-coverage-longer=false',  // Enable alignment coverage cutoff for longer seq
            // '--alignment-coverage-longer=0.9',   // Coverage fraction for longer seq [0..1]; only if set-alignment-coverage-longer=true
            '--set-alignment-coverage-shorter=false', // Enable alignment coverage cutoff for shorter seq
            // '--alignment-coverage-shorter=0.9',  // Coverage fraction for shorter seq [0..1]; only if set-alignment-coverage-shorter=true
            '--max-unmatched-percentage-longer=1.0',  // Max unmatched % for longer seq [0..1]
            '--max-unmatched-percentage-shorter=1.0', // Max unmatched % for shorter seq [0..1]
            '--alignment-position-constrains=false',  // Force alignment at sequence beginnings (+/+ only)
            '--save-clusters=true',                 // Save cluster membership file alongside FASTA
        ].join(' ')
    }

    // ── 06 TransDecoder ORF prediction ────────────────────────────────────────
    withName: 'TRANSDECODER' {
        ext.outdir = '06_transdecoder'
        ext.args = [
            '--genetic-code=Universal',             // [Universal|Candida|Ciliate|...] Genetic code table
            '--minimum-length=100',                 // Min protein length (aa); min 0
            '--strand-specific=false',              // Only analyze the top strand
            '--pfam=false',                         // Use Pfam domain searches to identify ORFs
            '--retain-long-orfs-mode=dynamic',      // [dynamic|strict] ORF retention mode
            // '--retain-long-orfs-length=1000000', // Min ORF length in strict mode; only if retain-long-orfs-mode=strict
            '--single-best-only=false',             // Retain only the single best ORF per transcript
            '--no-refine-starts=false',             // false = refine start codons via PWM (recommended)
            '--top-longest-orfs=500',               // Top longest ORFs for Markov model training [min 0]
        ].join(' ')
    }

    // ── 07 Load protein sequences ──────────────────────────────────────────────
    withName: 'LOAD_FASTA' {
        ext.outdir = '07_load_fasta'
        ext.args = [
            "--handle-double-ids=replace", // [skip, replace, add_with_new_id] Decide what to do with duplicated sequence IDs. Default: replace
            "--add-description=true"       // [true, false] Add everything after first whitespace in header as description. Default: true
        ].join(' ')
    }

    // ── 08 DIAMOND BLAST ──────────────────────────────────────────────────────
    withName: 'DIAMOND_BLAST' {
        ext.outdir = '08_diamond_blast'
        // TOOL ARGUMENTS: Uncomment and modify as needed.
        ext.args = [
            //"--species=9606",              // Specify taxonomies to blast against (comma-separated string).
            "--blast-mode=blastx",         // [blastx, blastp] Default: blastx
            "--database=nr_20250925",      // Target BLAST database: [refseq_protein_20250925, refseq_227_20241120, refseq_224_20240711, refseq_223_20240411, refseq_221_20240109, refseq_220_20230921, refseq_216_20230201, nr_20250925, nr_20241120, nr_20240711, nr_20240411, nr_20240109, nr_20230921, nr_20230201, swissprot_20250925, swissprot_20241120, swissprot_20240711, swissprot_20240411, swissprot_20240109, swissprot_20230921, swissprot_20230201]
            "--sensitivity=more_sensitive",// [fast, mid_sensitive, standard, sensitive, more_sensitive, very_sensitive, ultra_sensitive]
            "--blast-expect-value=1.0E-3", // [1000, 10, 5, 1, 0.1, 1.0E-3, 1.0E-5, ...] Default: 1.0E-3
            "--number-of-hits=20",         // [integer] Default: 20
            "--blast-min-hsplength=33",    // [integer] Default: 33
            "--hsp-hit-coverage-cutoff=0", // [integer] Default: 0
            "--long-queries=false",        // Set to true to optimize for long sequences (>30 kbp).
            "--taxa-filter-option=\"Include only the selected taxonomies in the search\"", // ["Include only the selected taxonomies in the search", "Exclude all selected taxonomies from the search"] Use the taxonomy id list to either include or exclude the selected taxonomies.
        ].join(' ')
    }

    // ── 09 InterProScan ───────────────────────────────────────────────────────
    withName: 'INTERPROSCAN' {
        ext.outdir = '09_interproscan'
        // TOOL ARGUMENTS: Uncomment and modify as needed.
        ext.args = [
            "--anti-fam=true",          // [true, false] AntiFam member database. Default: true
            "--f-print-scan=true",      // [true, false] FPrintScan member database. Default: true
            "--hmmpfam=true",           // [true, false] HMMER/Pfam member database. Default: true
            "--fun-fam=true",           // [true, false] FunFam member database. Default: true
            "--profile-scan=true",      // [true, false] ProfileScan member database. Default: true
            "--hamap=true",             // [true, false] HAMAP member database. Default: true
            "--pattern-scan=false",     // [true, false] PatternScan member database. Default: false
            "--super-family=true",      // [true, false] SUPERFAMILY member database. Default: true
            "--hmm-panther=true",       // [true, false] PANTHER member database. Default: true
            "--gene3d=true",            // [true, false] Gene3D member database. Default: true
            "--coils=false",            // [true, false] Coils member database. Default: false
            "--cdd=true",               // [true, false] CDD member database. Default: true
            "--sfld=true",              // [true, false] SFLD member database. Default: true
            "--pirsr=true",             // [true, false] PIRSR member database. Default: true
            "--pirsf=true",             // [true, false] PIRSF member database. Default: true
            "--ncbi-fam=true",          // [true, false] NCBIfam member database. Default: true
            "--export-format=xml,gff3"  // [xml, gff3, tsv, ...] Output export formats. Default: xml,gff3
        ].join(' ')
    }

    // ── 10 EggNOG Mapper ──────────────────────────────────────────────────────
    withName: 'EGGNOG_MAPPER' {
        ext.outdir = '10_eggnog_mapper'
        // TOOL ARGUMENTS: Uncomment and modify as needed.
        ext.args = [
            "--taxonomic-scope=auto",          // [auto, ...] Taxonomic scope for annotation. Default: auto
            "--target-orthologs=all",          // [all, one2one, many2one, one2many, many2many] Default: all
            "--go-evidence=non-electronic",    // [non-electronic, all] GO evidence type filter. Default: non-electronic
            "--i-type-options=genes",          // [cds, genes, proteins] Input sequence type. Default: genes
            "--blast-expect-value=1.0E-3"      // E-value threshold for BLAST. Default: 1.0E-3
        ].join(' ')
    }

    // ── 11 Combine Diamond and InterProScan ────────────────────────────────────
    withName: 'COMBINE_PROJECTS' {
        ext.outdir = '11_combine_projects'
        // TOOL ARGUMENTS: Uncomment and modify as needed.
        ext.args = [
            "--merge-sequence-data=add",        // [add, skip, replace] Add sequences if they do not exist. Default: add
            "--merge-sequence-description=add", // [add, skip, replace] Merge headers/descriptions. Default: add
            "--merge-blast-go-mapping=add",     // [add, skip, replace] Merge candidate GO mappings. Default: add
            "--merge-go-annotation=add",        // [add, skip, replace] Merge functional GO terms. Default: add
            "--merge-ips-annotation=add",       // [add, skip, replace] Merge InterPro domain terms. Default: add
            "--main-project=project1"           // [project1, project2] Define priority project layout. Default: project1
        ].join(' ')
    }

    // ── 12 Merge with EggNOG annotations ───────────────────────────────────────
    withName: 'MERGE_EGGNOG_5_GOS' {
        ext.outdir = '12_merge_eggnog'
        // TOOL ARGUMENTS: Uncomment and modify as needed.
        ext.args = [
            "--evalue-filter=10",       // Discard protein match alignments with a higher E-Value. Default: 10
            "--bit-score-filter=10.0"   // Discard protein match alignments with a lower bit-score. Default: 10.0
        ].join(' ')
    }
}
