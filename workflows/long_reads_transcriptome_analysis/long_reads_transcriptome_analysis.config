// --- FILE: long_reads_transcriptome_analysis.config ---
// Long-Read Transcriptome Analysis pipeline configuration.
// =================================================================

params {

    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    input_reads   = null         // REQUIRED: glob for long reads FASTA/Q (e.g. 'data/*.fastq.gz'). Reused by LongQC, Minimap2 and FLAIR.
    input_fasta   = null         // REQUIRED: reference genome FASTA (used by Minimap2, FLAIR, SQANTI3). Same version as the annotation.
    input_gff     = null         // REQUIRED: reference transcriptome annotation GTF (used by FLAIR --i-annotation-file and SQANTI3 --i-ref-annot).
    local_folder  = './results'  // Base output directory for all workflow results
    chart_format  = 'box'        // Output chart format: [box, png, pdf, csv]

    // ---------------------------------------------------
    // STEP-SPECIFIC PARAMETERS
    // ---------------------------------------------------

    minimap2 {
        junc_bed = null  // Optional: junction BED/GTF/BAM file. To use it you MUST also set --use-junc-bed=true below.
    }

    flair {
        junction_bed = null  // Optional: short-read splice junctions (BAM with XS tag, or STAR SJ.out.tab; one or more files). To use them you MUST also set --junction-bed-check=true below.
    }

    sqanti3 {
        // SQANTI3 input MODE. Single source of truth: the module injects --pb-or-gff and the matching --i-*-file
        // from this value, and the workflow feeds the input the chosen mode requires.
        //   'GFF'        -> --i-gff-file          : reconstructed isoform GTF. Input comes from FLAIR (recommended; no internal mapping/collapse).
        //   'TRANSCRIPT' -> --i-transcriptome-file: uses params.sqanti3.transcriptome_file (below).
        //   'PACBIO'     -> --i-pac-bio-file      : uses params.sqanti3.pacbio_file (below).
        // NOTE: FLAIR (and Minimap2) still run in every mode; in TRANSCRIPT/PACBIO their reconstructed GTF is simply not consumed by SQANTI3.
        pb_or_gff = 'GFF'

        // ADD ONLY IF pb_or_gff = 'TRANSCRIPT': FASTA/Q file with transcript SEQUENCES (already collapsed / non-redundant).
        // SQANTI3 maps them with minimap2 and converts the BAM to a GTF respecting splice sites. Ignored in the other modes.
        transcriptome_file = null

        // ADD ONLY IF pb_or_gff = 'PACBIO': FASTA/Q file with RAW long reads (PacBio IsoSeq HQ or Nanopore).
        // SQANTI3 maps them with minimap2 and collapses with cDNA Cupcake to generate non-redundant isoforms. Ignored in the other modes.
        pacbio_file = null

        // Optional SHORT-READ support (highly recommended). Short reads (need NOT be from the same experiment as the
        // long reads) validate splice-junction existence during filtering. Leave null to run WITHOUT short reads
        // (the module then injects --use-of-sr=false). If set, the module injects --use-of-sr=true --sequencing=<type>
        // --i-short-reads=<files>. Accepts one or more FASTQ files (e.g. 'data/sr/*.fastq.gz').
        short_reads = null
        // REQUIRED when short_reads is set (no default): you must choose the short-read layout.
        //   'fastq_pe' -> paired-end (isoform expression IS studied)
        //   'fastq_se' -> single-end. WARNING: SQANTI3 then runs STAR only to get splice-junction COVERAGE; isoform
        //                 EXPRESSION is NOT retrieved. Use 'fastq_pe' if you also want isoform expression.
        short_reads_type = null

        // R1/R2 filename patterns for PAIRED-END short reads. Only used when short_reads is set AND short_reads_type='fastq_pe'.
        // Commented by default: the module injects --upstream-pattern / --downstream-pattern with the tool defaults (_1 / _2).
        // Uncomment to override (e.g. '_R1' -> sample_R1.fastq.gz).
        //upstream_pattern   = '_1'
        //downstream_pattern = '_2'

        // Optional EXTRA annotation inputs (all null by default). Each is injected COHERENTLY with its --*-check toggle by
        // the module: file provided -> --X-check=true + --i-X=<file>; absent -> --X-check=false. Refine transcript curation.
        tss_file   = null  // BED with Transcription Start Site (TSS) annotations -> --i-tss-file. Refines transcript 5' ends (only human/mouse public files available).
        polya_file = null  // TXT with polyA motifs, one motif (string of nucleotides) per line -> --i-polya-file. Refines transcript 3' ends.
        polya_peak = null  // BED with polyA peaks/sites -> --i-poly-apeak. Complements polyA-motif evidence at 3' ends.
        // NOTE: SQANTI3's FL counts (--i-fl-file) are NOT a user param here: FLAIR always runs and produces them
        //       (quantification.counts.sqanti3.tsv). The workflow feeds FLAIR's counts to SQANTI3 automatically in GFF mode.
        // Custom-rules JSON -> --i-json. REQUIRED only when the filtering method is RULES_FILTER (see --filtering in ext.args below);
        // ignored with any other filtering method. The module injects --i-json when this is set.
        rules_json = null
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION (CLI INJECTIONS)
// ---------------------------------------------------
process {

    // =================================================================
    // PHASE 1: LONG-READ QUALITY ASSESSMENT (LongQC)  [isolated QC]
    // =================================================================
    withName: 'LONGQC' {
        ext.outdir = '01_longqc'
        ext.args = [
            "--preset=pb-rs2",          // [pb-rs2, pb-sequel, pb-hifi, ont-ligation, ont-rapid, ont-1dsq] Sequencing technology profile -- MUST match your data
            "--output-trimmed=true",          // [true, false] Produce trimmed reads. Default: true (kept true because the module declares the trimmed output as mandatory)
            "--transcript=true",              // [true, false] Analyze transcripts/RNA/cDNA sequences. Default: false (true for a transcriptome run)
            "--short-mode=false"              // [true, false] Highly sensitive setting for short/erroneous reads. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: LONG-READ ALIGNMENT (Minimap2)  [WJOB_ASYNC]
    // (No --chart-format flag for this tool; its chart is fixed .box)
    // =================================================================
    withName: 'MINIMAP2' {
        ext.outdir = '02_minimap2'
        ext.args = [
            // -- Preset --
            "--preset-options=MAP_ONT",       // [MAP_ONT, MAP_HIFI, MAP_PB, SPLICE, SPLICE_HQ] Preset. Use SPLICE/SPLICE_HQ for spliced transcriptome alignment. Default: MAP_ONT

            // -- Indexing --
            "--kmer=15",                      // [0-29] Minimizer k-mer length. Default: 15
            "--window-size=10",               // [integer >=0] Minimizer window size (~2/3 of k-mer). Default: 10
            "--hpc=false",                    // [true, false] Homopolymer-compressed minimizers (recommended for PacBio). Default: false

            // -- Seeding --
            "--ignore-minimizers=2.0E-4",  // [double] Ignore top fraction of frequent minimizers. Default: 2.0E-4
            "--q-occ-frac=0.01",           // [double] Discard high-occurrence query minimizers (0 = disabled). Default: 0.01
            "--low-minimizer=10",          // [integer >=0] Lower bound of k-mer occurrences. Default: 10
            "--max-minimizer=1000000",     // [integer >=0] Upper bound of k-mer occurrences. Default: 1000000
            "--sample-higher=500",         // [integer >=1] Bp before sampling a high-frequency minimizer. Default: 500

            // -- Chaining --
            "--stop-chain-elong=10000",    // [integer >=1] Bp to look for minimizers after stopping chain elongation. Default: 10000
            "--bandwidth-chain=500",       // [integer >=1] Bandwidth for initial chaining. Default: 500
            "--bandwidth-base=200000",     // [integer >=1] Bandwidth for RMQ re-chaining. Default: 200000
            "--discard-chain-minimizers=3",// [integer >=1] Discard chains with fewer minimizers. Default: 3
            "--discard-chain-score=40",    // [integer >=1] Minimum chaining score to keep a chain. Default: 40
            "--chain-gap-scale=1.0",       // [double >=0.1] Gap cost scale during chaining. Default: 1.0

            // -- Secondary Alignments -- (only if retain-secondary=true)
            "--retain-secondary=false",       // [true, false] Retain secondary alignments. Default: false
            // "--min-secondary=0.8",         // [double] Min secondary-to-primary score ratio (only if retain-secondary=true). Default: 0.8
            // "--n-secondary=5",             // [integer >=1] Max secondary alignments (only if retain-secondary=true). Default: 5
            // "--mark-secondary=0.5",        // [double] Mark-as-secondary overlap fraction (only if retain-secondary=true). Default: 0.5

            // -- Splice -- (only if splice=true)
            "--splice=false",                 // [true, false] Enable splice alignment mode. Default: false
            // "--max-gap=200000",            // [integer >=1] Max gap (only if splice=true). Default: 200000
            // "--non-canonical-splice=0",    // [integer >=0] Cost for non-canonical GT-AG splicing (only if splice=true). Default: 0
            // "--find-splice=BOTH",          // [TRANSCRIPT, BOTH] Where to find splice sites (only if splice=true). Default: BOTH
            // "--splice-flank=true",         // [true, false] Assume conserved donor/acceptor flanks (only if splice=true). Default: true

            // -- Alignment --
            "--match-score=2",                // [integer >=1] Match score. Default: 2
            "--mismatch-penalty=4",           // [integer >=1] Mismatch penalty. Default: 4
            "--gap-open1=4",                  // [integer >=1] Gap open penalty. Default: 4
            "--gap-ext1=2",                   // [integer >=1] Gap extension penalty. Default: 2
            "--gap-open2=24",                 // [integer >=1] Gap open penalty (2nd). Default: 24
            "--gap-ext2=1",                   // [integer >=1] Gap extension penalty (2nd). Default: 1
            "--score-n=1",                    // [integer >=0] Score of a mismatch involving ambiguous bases. Default: 1
            "--end-bonus=0",                  // [integer >=0] Score bonus when alignment extends to the query end. Default: 0

            // -- Splice Junctions Information -- (only if use-junc-bed=true)
            "--use-junc-bed=false",            // [true, false] Use a junction BED file. Default: false. If true: provide params.minimap2.junc_bed
            // "--junc-bonus=9",              // [integer >=1] Score bonus for annotated splice sites (only if use-junc-bed=true). Default: 9

            // -- Output (BAM) Options --
            "--max-qlen=0",                   // [integer >=0] Filter out queries longer than this (0 = disabled). Default: 0
            "--hit-only=false",               // [true, false] Output only mapped reads. Default: false
            "--cigar=true",                   // [true, false] Generate CIGAR in the BAM. Default: true
            "--long-cigar=true",              // [true, false] Write long CIGAR (>65535 ops) at the CG tag (only if cigar=true). Default: true
            "--md-tag=false",                 // [true, false] Add MD tag. Default: false
            "--cs-tag=false",                 // [true, false] Add CS tag. Default: false

            "--ignore-bq=false"              // [true, false] Ignore base quality in the input. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 3: ISOFORM IDENTIFICATION & QUANTIFICATION (FLAIR)
    // (--chart-format is injected by the module from params.chart_format)
    // NOTE: --use-annotation-file is NOT set here. The FLAIR module injects it AUTOMATICALLY from the presence of
    //       the annotation GTF: file present -> --use-annotation-file=true --i-annotation-file=<gtf>; absent ->
    //       --use-annotation-file=false. In this pipeline input_gff is always provided (required by SQANTI3).
    // =================================================================
    withName: 'FLAIR' {
        ext.outdir = '03_flair'
        ext.args = [
            // -- Reconstruction and/or Quantification --
            "--do-reconstruction=true",       // [true, false] Reconstruct the transcriptome (correct + collapse). Default: true. If false, most params below are ignored.
            "--do-quantification=true",       // [true, false] Quantify isoform expression. Default: true
            // NOTE: The GTF is only STRICTLY required to quantify WITHOUT reconstruction; otherwise short-read junctions can replace it.
            // NOTE: --aligned-reads-check is NOT set here. The FLAIR module injects it from the PRESENCE of the aligned-reads
            //       input (agnostic to the workflow): BAM present -> --aligned-reads-check=true (--i-aligned-reads);
            //       empty -> --aligned-reads-check=false (FLAIR aligns internally). In this workflow the .nf wires Minimap2's
            //       BAM into FLAIR, so it is present -> true.
            "--junction-bed-check=false",     // [true, false] Use short-read junctions (--i-junction-bed) to guide alignment/correction. Default: false. If true: provide params.flair.junction_bed

            // Internal-alignment params: ONLY apply when FLAIR aligns itself (--aligned-reads-check=false, i.e. no aligned-reads BAM wired in). Uncomment to tune.
            // "--nvrna-align=false",         // [true, false] Native-RNA minimap2 params (only if aligned-reads-check=false)
            // "--quality-align=1",           // [integer >=1] Min mapping quality to the genome (only if aligned-reads-check=false)
            // "--secondary-align=0",         // [integer >=0] Secondary alignments to retain (only if aligned-reads-check=false)

            // -- Correct --
            "--ss-window=15",                 // [integer >=1] Window size for correcting splice sites. Default: 15

            // -- Collapse --
            "--support-collapse=3",           // [integer >=1] Min supporting reads for an isoform. Default: 3
            "--no-redundant=NONE",            // [NONE, LONGEST, BEST_ONLY] TSS/TTS redundancy control per splice-junction chain. Default: NONE
            "--filter-isoforms=DEFAULT",      // [DEFAULT, NOSUBSET, COMPREHENSIVE, GINORMOUS] Isoform filtering strategy. Default: DEFAULT

            "--trust-ends-collapse=false",    // [true, false] Reads have minimal fragmentation (collapse). Default: false
            "--check-splice-collapse=false",  // [true, false] Enforce coverage around splice sites (collapse). Default: false
            "--quality-collapse=1",           // [integer >=1] Min mapping quality of read->isoform assignment (collapse). Default: 1
            "--end-window-collapse=100",      // [integer >=1] Window to compare TSS/TTS. Default: 100
            "--isoform-tss-collapse=false",   // [true, false] Determine TSS/TTS per isoform (else per gene). Default: false
            "--no-gtf-end-adj-collapse=false",// [true, false] Do not adjust isoform TSS/TTS from the GTF. Default: false

            // -- Collapse and Quantify --
            "--quality-quantify=1",           // [integer >=1] Min MAPQ of read->isoform assignment (quantify). Default: 1
            "--trust-ends=false",             // [true, false] Reads have minimal fragmentation (quantify). Default: false
            "--check-splice-quantify=false",  // [true, false] Enforce coverage around splice sites (quantify). Default: false
            "--stringent-quantify=false"      // [true, false] Supporting reads must cover 80% of the isoform and extend into first/last exons. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 4: TRANSCRIPTOME CURATION (SQANTI3)
    // (No --chart-format flag / chart outputs for this tool)
    // NOTE: --pb-or-gff and its matching --i-*-file are NOT set here. The module injects them from
    //       params.sqanti3.pb_or_gff (the single source of truth). Change the mode there, not here.
    // =================================================================
    withName: 'SQANTI3' {
        ext.outdir = '04_sqanti3'
        ext.args = [
            // NOTE: --use-of-sr, --sequencing, --i-short-reads and (for paired-end) --upstream-pattern/--downstream-pattern
            //       are injected by the module from the params.sqanti3 block (short_reads / short_reads_type / *_pattern).
            //       Single source of truth - do NOT set them here.

            // -- Quality Control --
            "--force-id-ignore=false",        // [true, false] Allow transcript IDs different from PB.x.y. Default: false
            "--min-ref-len=200",              // [integer >=1] Min reference transcript length to pass the filter. Default: 200
            "--skip-orf=false",               // [true, false] Skip ORF prediction (saves time). Default: false
            // "--fasta-amino-file=true",     // [true, false] Output translated-ORF FASTA (only if skip-orf=true). Default: true
            "--set-of-splices=ATAC,GCAG,GTAG",// [string] Comma-separated canonical splice sites. Default: ATAC,GCAG,GTAG
            "--window=20",                    // [integer >=1] Genomic window screened for downstream Adenine content (TTS). Default: 20
            "--gene-name=false",              // [true, false] Use gene_name tag instead of gene_id to define genes. Default: false

            "--filtering=ML",                 // [ML, DEFAULT, RULES_FILTER] Filtering method. Default: ML

            // -- ML Filtering -- (only if filtering=ML)
            "--adenine-percent=60",           // [25-100] Genomic 3' Adenine %% to flag intra-priming (only if filtering=ML). Default: 60
            "--force-fsm=false",              // [true, false] Always keep FSM transcripts (only if filtering=ML). Default: false
            "--ml-threshold=0.7",             // [0.25-1.0] ML probability threshold to classify as isoform (only if filtering=ML). Default: 0.7
            "--filter-mono-exonic=false",     // [true, false] Remove single-exon transcripts (only if filtering=ML). Default: false
            // "--i-json"  -> REQUIRED only if filtering=RULES_FILTER. Provide the rules JSON via params.sqanti3.rules_json (the module injects --i-json). Ignored for ML/DEFAULT.

            // -- Rescue --
            "--do-rescue=true",               // [true, false] Rescue transcripts from artifacts. Default: true
            "--rescue-mono-exonic=all",       // [fsm, all, none] Include mono-exonic artifacts in rescue (only if do-rescue=true). Default: all
            "--rescue-mode=automatic",        // [automatic, full] Rescue mode (only if do-rescue=true). Default: automatic

            // NOTE: the optional checks --tss-check / --polya-check / --poly-apeak-check are injected by the module,
            //       kept coherent with params.sqanti3.tss_file / polya_file / polya_peak. --fl-check is also injected by
            //       the module, but its file (--i-fl-file) comes from FLAIR's counts automatically (GFF mode), NOT a param.
            //       Do NOT set any of these here.

            "--output-prefix=sqanti3"         // [string] Prefix for output files. Default: sqanti3
        ].join(' ')
    }
}
