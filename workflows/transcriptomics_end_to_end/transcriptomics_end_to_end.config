// --- FILE: transcriptomics_end_to_end.config ---
// Transcriptomics End-to-End pipeline configuration.
// =================================================================

params {

    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    input_single_end = null         // Glob for single-end reads (e.g. 'data/*.fastq.gz')
    input_paired_end = null         // Glob for paired-end reads (e.g. 'data/*_{1,2}.fastq.gz')
    local_folder     = './results'  // Base output directory for all workflow results
    cloud_folder     = null         // Cloud storage path for WJOB_ASYNC tools (e.g. 's3://my-bucket/omicsbox-outputs/')

    // ---------------------------------------------------
    // INPUT-SPECIFIC PARAMETERS
    // ---------------------------------------------------
    //upstream_pattern   = '_1'     // R1 filename pattern for PE reads (e.g. '_1' → sample_1.fastq.gz)
    //downstream_pattern = '_2'     // R2 filename pattern for PE reads (e.g. '_2' → sample_2.fastq.gz)

    trimmomatic {
        adapters = null  // Optional: custom adapter FASTA file for trimming
    }

    fastqc {
        adapters     = null  // Optional: custom adapter FASTA file for QC screening
        contaminants = null  // Optional: custom contaminant FASTA file for QC screening
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION (CLI INJECTIONS)
// ---------------------------------------------------
process {

    // =================================================================
    // PHASE 1: READ PREPROCESSING & TRIMMING
    // =================================================================
    withName: 'TRIMMOMATIC' {
        ext.outdir = '01_trimmomatic'
        ext.args = [
            "--quality-encoding=auto",                   // [auto, phred33, phred64] Auto-detect read quality encoding. Default: auto
            // "--prefix=trimmed_",                      // Output filename prefix
            // "--upstream-pattern-preprocessing=_1",    // Pattern for upstream fastq files (e.g. '_1') (PE mode)
            // "--downstream-pattern-preprocessing=_2",  // Pattern for downstream fastq files (e.g. '_2') (PE mode)
            "--remove-adapters=false",                   // [true, false] Find and remove adapters/contaminants. Default: false
            // "--adapter-options=default",              // [default, custom] Adapter removal strategy (only if remove-adapters=true)
            // "--seed-mismatches=2",                    // Max mismatches for full adapter match (only if remove-adapters=true)
            // "--palindrome-clip-threshold=30",         // PE palindrome alignment accuracy (only if remove-adapters=true)
            // "--simple-clip-threshold=15",             // Adapter match accuracy (only if remove-adapters=true)
            // "--adapter-list=TruSeq3-PE.fa",           // [TruSeq3-SE.fa, TruSeq2-SE.fa, NexteraPE-PE.fa] (only if adapter-options=default)
            // "--min-adapter-length=8",                 // Min detectable adapter length (only if remove-adapters=true)
            // "--keep-both-reads=true",                 // Retain reverse read after PE palindrome detection (only if remove-adapters=true)
            "--edge-trimming=false",                     // [true, false] Enable trimming from sequence edges. Default: false
            // "--edge-trimming-options=qual",           // [qual, length] Edge trimming strategy (only if edge-trimming=true)
            // "--qual-trimming-from5p=true",            // Remove low-quality bases from 5' end (only if edge-trimming-options=qual)
            // "--normal-trimming-threshold5p=30",       // Min quality at 5' (only if qual-trimming-from5p=true)
            // "--qual-trimming-from3p=true",            // Remove low-quality bases from 3' end (only if edge-trimming-options=qual)
            // "--normal-trimming-threshold3p=30",       // Min quality at 3' (only if qual-trimming-from3p=true)
            // "--length-trimming-from5p=false",         // Crop N bases from 5' (only if edge-trimming-options=length)
            // "--length-trimming-threshold5p-remove=3", // Bases to remove from 5' (only if length-trimming-from5p=true)
            // "--length-trimming-from3p=false",         // Crop to fixed length from 3' (only if edge-trimming-options=length)
            // "--length-trimming-threshold3p-keep=150", // Bases to keep from start (only if length-trimming-from3p=true)
            // "--quality-trimming=false",               // [true, false] Enable sliding-window or maxinfo trimming
            // "--quality-trimming-options=sliding",     // [sliding, maxinfo] Quality trimming algorithm (only if quality-trimming=true)
            // "--window-size=4",                        // Sliding window width (only if quality-trimming-options=sliding)
            // "--required-quality=15",                  // Min avg quality in window (only if quality-trimming-options=sliding)
            // "--target-length=40",                     // Target read length for maxinfo (only if quality-trimming-options=maxinfo)
            // "--strictness=0.5",                       // [0.0-1.0] Length vs correctness tradeoff (only if quality-trimming-options=maxinfo)
            // "--filter-by-quality=true",               // [true, false] Discard reads below average quality. Default: false
            // "--average-quality=25",                   // Min average quality to retain read (only if filter-by-quality=true)
            // "--filter-by-length=true",                // [true, false] Discard reads below minimum length. Default: false
            // "--minimum-length=36"                     // Min retained read length in bp (only if filter-by-length=true)
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: QUALITY CONTROL (POST-PREPROCESSING)
    // =================================================================
    withName: 'FASTQC' {
        ext.outdir = '02_fastqc'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

}