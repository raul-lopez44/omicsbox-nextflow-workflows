// --- FILE: nextflow.config ---

params {
    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    local_folder   = './results'
    cloud_folder   = null  // Path to the cloud storage bucket or directory (e.g., s3://my-bucket/path/)
    input_single_end = null
    input_paired_end = null
    // upstream-pattern = '_1'  // Pattern for upstream fastq files (e.g., '_1' for paired-end reads)
    // downstream-pattern = '_2' // Pattern for downstream fastq files (e.g., '_2' for paired-end reads)

    // ---------------------------------------------------
    // TRIMMOMATIC SPECIFIC PARAMETERS
    // ---------------------------------------------------
    trimmomatic {
        // FILES: Only paths/files are defined as parameters to allow channel staging
        // Provide the path to a custom fasta file, or leave as null
        adapters = null 
    }

    // ---------------------------------------------------
    // FASTQC SPECIFIC PARAMETERS
    // ---------------------------------------------------
    fastqc {
        // FILES: Optional custom adapter / contaminant FASTA files (OmicsBox searches defaults if null)
        adapters = null
        contaminants = null
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION (CLI INJECTIONS)
// ---------------------------------------------------
process {
withName: 'TRIMMOMATIC' {

        ext.outdir = '01_trimmomatic'

        // TOOL ARGUMENTS: Uncomment and modify as needed.
        // If conflicting flags are used, the OmicsBox engine will throw an error.
        ext.args = [
            // --- General & Input Options ---
            '--quality-encoding=auto',                 // [auto, phred33, phred64] Select quality score encoding.
            // '--prefix=trimmed_',                    // Define a prefix to set the name of output files.
            
            // Paired-end Configuration
            // '--upstream-pattern-preprocessing=_1',  // Pattern for upstream fastq files (e.g., '_1').
            // '--downstream-pattern-preprocessing=_2',// Pattern for downstream fastq files (e.g., '_2').
            
            // --- Adapter Removal Configuration ---
            '--remove-adapters=false',                 // Set to true to find and remove adapters and contaminants.
            
            // Remove Adapters Options
            // '--adapter-options=default',            // [default, custom] Choose between default or custom adapters.
            // '--seed-mismatches=2',                  // Maximum mismatch count which still allows a full match.
            // '--palindrome-clip-threshold=30',       // Accuracy required for PE palindrome alignment.
            // '--simple-clip-threshold=15',           // Accuracy required for adapter sequence against a read.
            
            // Default adapter options
            // '--adapter-list=TruSeq3-PE.fa',         // [TruSeq3-SE.fa, TruSeq2-SE.fa, NexteraPE-PE.fa] For default mode.
            
            // Paired-end Mode
            // '--min-adapter-length=8',               // Minimum length for adapters to be detected.
            // '--keep-both-reads=true',               // Retain reverse read after palindrome read-through detection.
            
            // --- Edge Trimming Configuration ---
            '--edge-trimming=false',                 // Enable trimming sequences from the edges.
            
            // Edge Trimming Options
            // '--edge-trimming-options=qual',         // [qual, length] Trimming strategy.

            // Quality-based edge trimming options
            // '--qual-trimming-from5p=true',          // Remove low quality bases from 5' end.
            // '--normal-trimming-threshold5p=30',      // Min quality to keep a base from 5'.
            // '--qual-trimming-from3p=true',          // Remove low quality bases from 3' end.
            // '--normal-trimming-threshold3p=30',      // Min quality to keep a base from 3'.

            // Length-based edge trimming options
            // '--length-trimming-from5p=false',        // Remove bases regardless of quality from 5'.
            // '--length-trimming-threshold5p-remove=3', // Number of bases to remove from 5'.
            // '--length-trimming-from3p=false',        // Crop the sequence from 3'.
            // '--length-trimming-threshold3p-keep=150', // Number of bases to keep from the start.
            
            // --- Quality Trimming Configuration ---
            // '--quality-trimming=false',              // Enable sequence trimming based on quality/length across read.
            
            // Quality trimming options
            // '--quality-trimming-options=sliding',   // [sliding, maxinfo] Trimming algorithm.

            // Sliding window trimming options
            // '--window-size=4',                      // Window size for sliding window trimming.
            // '--required-quality=15',                // Average quality required within the sliding window.

            // Adaptative trimming options
            // '--target-length=40',                   // Target read length for maxinfo algorithm.
            // '--strictness=0.5',                     // [0.0..1.0] Balance between read length vs correctness (maxinfo).
            
            // --- Filtering Options ---
            // '--filter-by-quality=true',             // Discard the read if average quality is too low.
            // '--average-quality=25',                 // Minimum average quality of reads to be kept.
            // '--filter-by-length=true',              // Discard the read if it is too short.
            // '--minimum-length=36',                  // Minimum length of reads to be kept.
            
        ].join(' ') // Joins the uncommented elements with a single space
    }

withName: 'FASTQC' {

        ext.outdir = '02_fastqc'

        // TOOL ARGUMENTS: Uncomment and modify as needed.
        // If conflicting flags are used, the OmicsBox engine will throw an error.
        ext.args = [
            // --- Configuration ---
            '--binning=true',                        // Group bases in plots (recommended for long reads >50 bp to avoid tiny plots).
            // --keep-inputs-in-cloud                 // Retain uploaded input files in the cloud after the run. Useful when chaining pipeline steps that reuse the same inputs.
        ].join(' ')
    }
}