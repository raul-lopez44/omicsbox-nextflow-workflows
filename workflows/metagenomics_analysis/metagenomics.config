// --- FILE: metagenomics_analysis.config ---
// Metagenomics Analysis pipeline configuration.
// =================================================================

params {

    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    input_single_end           = null         // Single-end reads glob (e.g. 'data/*.fastq.gz')
    input_paired_end           = null         // Paired-end reads glob (e.g. 'data/*_{1,2}.fastq.gz')
    local_folder               = './results'  // Base output directory for all workflow results
    cloud_folder               = null         // Cloud storage path for WJOB_ASYNC tools
    chart_format               = 'box'        // Output chart format: [box, png, pdf, csv]

    // ---------------------------------------------------
    // READ PROCESSING PARAMETERS
    // ---------------------------------------------------
    trimmomatic {
        adapters = null  // Optional: custom adapter FASTA file for trimming
    }

    fastqc {
        adapters     = null  // Optional: custom adapter FASTA file for QC screening
        contaminants = null  // Optional: custom contaminant FASTA file for QC screening
    }

    // ---------------------------------------------------
    // METAGENOMICS-SPECIFIC PARAMETERS
    // ---------------------------------------------------
    cont_rem {
        target_genome = null  // Optional: Custom target genome FASTA (e.g., Homo sapiens for host removal)
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION (CLI INJECTIONS)
// ---------------------------------------------------
process {

    // =================================================================
    // PHASE 1: RAW QUALITY CONTROL (PRE-TRIMMING)
    // =================================================================
    withName: 'FASTQC_RAW' {
        ext.outdir = '01_fastqc_raw'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: READ PREPROCESSING & TRIMMING
    // =================================================================
    withName: 'TRIMMOMATIC' {
        ext.outdir = '02_trimmomatic'
        ext.args = [
            "--quality-encoding=auto",               // [auto, phred33, phred64] Auto-detect encoding. Default: auto
            "--remove-adapters=false",               // [true, false] Enable adapter trimming. Default: false
            "--edge-trimming=false",                 // [true, false] Enable edge trimming. Default: false
            "--filter-by-quality=true",              // [true, false] Discard low-quality reads. Default: true
            "--average-quality=25",                  // [integer] Min average quality. Default: 25
            "--filter-by-length=true",               // [true, false] Discard short reads. Default: true
            "--minimum-length=36"                    // [integer] Min read length in bp. Default: 36
            // Additional optional parameters (uncomment to activate):
            // "--prefix=trimmed_",                  // Output filename prefix
            // "--quality-trimming=false",           // [true, false] Enable sliding-window trimming
            // "--window-size=4",                    // Sliding window width (only if quality-trimming=true)
        ].join(' ')
    }

    // =================================================================
    // PHASE 3: QUALITY CONTROL (POST-TRIMMING)
    // =================================================================
    withName: 'FASTQC_POST' {
        ext.outdir = '03_fastqc_post'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 4: CONTAMINANT REMOVAL
    // =================================================================
    withName: 'CONT_REM' {
        ext.outdir = '04_contaminant_removal'
        ext.args = [
            "--sequencing=fastq_pe",                 // [fastq_se, fastq_pe] Sequencing type. Default: fastq_pe
            "--result-mode=only_other",              // [only_aligned, only_other, both] CRITICAL: only_other for unaligned (clean reads). Default: only_other
            "--target-index=Homo sapiens (grch38)",  // Built-in index for common contamination. Options: Homo sapiens (grch38), etc. OR use --i-target-genome for custom

            // ---------------------------------------------------------
            // Advanced Parameters (Uncomment to tweak):
            // ---------------------------------------------------------
            // "--upstream-pattern=_1",              // Pattern for upstream PE reads. Default: _1
            // "--downstream-pattern=_2",            // Pattern for downstream PE reads. Default: _2
            // "--kmer-size=28",                     // [integer] K-mer size for indexing. Default: 28
            // "--minimum-query-coverage=30",        // [integer] Min query coverage %. Default: 30
            // "--minimum-subject-identity=85",      // [integer] Min subject identity %. Default: 85
            // "--minimum-query-identity=85",        // [integer] Min query identity %. Default: 85
            // "--minimum-alignment-length=50"       // [integer] Min alignment length in bp. Default: 50
        ].join(' ')
    }

    // =================================================================
    // PHASE 5: DE NOVO METAGENOME ASSEMBLY (MEGAHIT)
    // =================================================================
    withName: 'MEGAHIT' {
        ext.outdir = '05_megahit'
        ext.args = [
            "--sequencing=paired",                   // [single, paired, interleaved] Sequencing type. Default: paired
            "--minimum-multiplicity=2",              // [integer] Min k-mer frequency. Default: 2

            // ---------------------------------------------------------
            // Advanced Parameters (Uncomment to tweak):
            // ---------------------------------------------------------
            // "--upstream-pattern=_1",              // Default: _1
            // "--downstream-pattern=_2",            // Default: _2
            // "--kmer-sizes=29,39,59,79,99,119,141", // [string] K-mer list. Default: 29,39,59,79,99,119,141
            // "--no-mercy-kmers=false",             // [true, false] Default: false
            // "--bubble-level=2",                   // [0, 1, 2] Bubble removal aggressiveness. Default: 2
            // "--bubble-merge-l=20",                // [integer] Bubble merge link count. Default: 20
            // "--bubble-merge-s=0.95",              // [double] Bubble merge similarity. Default: 0.95
            // "--prune-level=2",                    // [0, 1, 2, 3] Tip/bulge pruning aggressiveness. Default: 2
            // "--prune-depth=2",                    // [integer] Tip/bulge max depth. Default: 2
            // "--low-local-ratio=0.2",              // [double] Low-local connection ratio. Default: 0.2
            // "--max-tip-length=2",                 // [integer] Max tip length in k-mers. Default: 2
            // "--no-local=false",                   // [true, false] Disable local assembly. Default: false
            // "--kmin1pass=false",                  // [true, false] One-pass for K-mers. Default: false
            // "--min-contig-length=200"             // [integer] Min contig output length. Default: 200
        ].join(' ')
    }

    // =================================================================
    // PHASE 6: PROKARYOTIC GENE FINDING (PRODIGAL)
    // =================================================================
    withName: 'PRODIGAL' {
        ext.outdir = '06_prodigal'
        ext.args = [
            "--procedure=meta",                      // [single, meta] CRITICAL: meta for metagenomics. Default: meta
            "--genetic-code=0",                      // [0, 1, 2, ...] Translation table. 0=Auto. Default: 0

            // ---------------------------------------------------------
            // Advanced Parameters (Uncomment to tweak):
            // ---------------------------------------------------------
            // "--closed-ends=false",                // [true, false] Genes closed at sequence ends. Default: false
            // "--masked-ns=false",                  // [true, false] Mask N regions. Default: false
            // "--skip-shine-dalgarno=false"         // [true, false] Skip Shine-Dalgarno search. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 7a: DOMAIN ANNOTATION (PFAM_SCAN)
    // =================================================================
    withName: 'PFAM_SCAN' {
        ext.outdir = '07_pfam_scan'
        ext.args = [
            // No advanced algorithm parameters in OmicsBox Pfam-Scan wrapper
            // All configuration is handled by the wrapper's defaults
        ].join(' ')
    }

    // =================================================================
    // PHASE 7b: FUNCTIONAL ANNOTATION (EggNOG)
    // =================================================================
    withName: 'EGGNOG_MAPPER' {
        ext.outdir = '07_eggnog'
        ext.args = [
            // Configured via eggnog_mapper module
        ].join(' ')
    }
}
