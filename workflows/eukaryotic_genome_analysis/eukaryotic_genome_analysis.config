// --- FILE: eukaryotic_genome_analysis.config ---
// Eukaryotic Genome Analysis pipeline configuration.
// =================================================================

params {

    // ---------------------------------------------------
    // GLOBAL PIPELINE PARAMETERS
    // ---------------------------------------------------
    input_single_end           = null         // Glob for single-end reads (e.g. 'data/*.fastq.gz')
    input_paired_end           = null         // Glob for paired-end reads (e.g. 'data/*_{1,2}.fastq.gz')
    local_folder               = './results'  // Base output directory for all workflow results
    cloud_folder               = null         // Cloud storage path for WJOB_ASYNC tools (e.g. 's3://my-bucket/omicsbox-outputs/')
    chart_format               = 'box'        // Output chart format: [box, png, pdf, csv]

    // ---------------------------------------------------
    // INPUT-SPECIFIC PARAMETERS
    // ---------------------------------------------------
    //upstream_pattern   = '_1'     // R1 filename pattern for PE reads (e.g. '_1' → sample_1.fastq.gz)
    //downstream_pattern = '_2'     // R2 filename pattern for PE reads (e.g. '_2' → sample_2.fastq.gz)

    trimmomatic {
        adapters = null  // Optional: custom adapter FASTA file for trimming
    }

    fastqc {
        adapters     = null  // Optional: custom adapter FASTA file for QC screening
        contaminants = null  // Optional: custom contaminant FASTA file for QC screening
    }

    // ---------------------------------------------------
    // ASSEMBLY & GENOME ANALYSIS PARAMETERS
    // ---------------------------------------------------
    abyss {
        // Optional auxiliary data inputs:
        linked_reads = null             // Optional: Linked reads (10x Genomics) for hybrid assembly
        additional_pe = null            // Optional: Additional paired-end libraries
        mate_pair = null                // Optional: Mate-pair reads for scaffolding
        long_sequences = null           // Optional: Long sequence reads (e.g. RNA-Seq contigs)
    }

    repeatmasker {
        search_engine = 'rmblast'       // Options: rmblast, hmmer
        database_type = 'repbase'       // Options: repbase, dfam_consensus, custom (Only used if search_engine = rmblast)
        database_file = null            // REQUIRED ONLY if search_engine = rmblast AND (database_type = repbase OR custom)
    }

    augustus {
        gene_finding_mode = 'abinitio'  // Options: abinitio, ee (Extrinsic Evidence)

        // Evidence hints for gene prediction (REQUIRED if gene_finding_mode = 'ee'):
        est_hints = null                // Optional: EST/cDNA evidence files
        protein_hints = null            // Optional: Protein evidence files
        isoseq_hints = null             // Optional: IsoSeq evidence files
        rna_seq_se_hints = null         // Optional: RNA-Seq single-end evidence
        rna_seq_pe_hints = null         // Optional: RNA-Seq paired-end evidence
    }

    quast {
        reference_genome = null         // Reference genome for QUAST evaluation
    }
}

// ---------------------------------------------------
// PROCESS SPECIFIC CONFIGURATION (CLI INJECTIONS)
// ---------------------------------------------------
process {

    // =================================================================
    // PHASE 1: RAW QUALITY CONTROL (PRE-TRIMMING)
    // =================================================================
    withName: 'FASTQC_RAW' {
        ext.outdir = '01_fastqc_raw'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 2: READ PREPROCESSING & TRIMMING
    // =================================================================
    withName: 'TRIMMOMATIC' {
        ext.outdir = '02_trimmomatic'
        ext.args = [
            "--quality-encoding=auto",               // [auto, phred33, phred64] Auto-detect encoding. Default: auto
            "--remove-adapters=false",               // [true, false] Enable adapter trimming. Default: false
            "--edge-trimming=false",                 // [true, false] Enable edge trimming. Default: false
            "--filter-by-quality=true",              // [true, false] Discard low-quality reads. Default: true
            "--average-quality=25",                  // [integer] Min average quality. Default: 25
            "--filter-by-length=true",               // [true, false] Discard short reads. Default: true
            "--minimum-length=36"                    // [integer] Min read length in bp. Default: 36
            // Additional optional parameters (uncomment to activate):
            // "--prefix=trimmed_",                  // Output filename prefix
            // "--adapter-options=default",          // [default, custom] Adapter removal strategy
            // "--quality-trimming=false",           // [true, false] Enable sliding-window trimming
            // "--quality-trimming-options=sliding", // [sliding, maxinfo] Trimming strategy
            // "--window-size=4",                    // Sliding window width (only if sliding mode)
            // "--required-quality=15"               // Min avg quality in window
        ].join(' ')
    }

    // =================================================================
    // PHASE 3: QUALITY CONTROL (POST-TRIMMING)
    // =================================================================
    withName: 'FASTQC_POST' {
        ext.outdir = '03_fastqc_post'
        ext.args = [
            "--binning=true"  // [true, false] Group bases in QC plots. Default: true
        ].join(' ')
    }

    // =================================================================
    // PHASE 4: DE NOVO GENOME ASSEMBLY (ABYSS)
    // =================================================================
    withName: 'ABYSS' {
        ext.outdir = '04_abyss'
        ext.args = [
            "--kmer-size=55",                        // [0-128] K-mer size for de Bruijn graph. Default: 55
            "--paired-bruijn-graph=false",           // [true, false] Use paired de Bruijn graph. Default: false
            // "--kmer-span=110",                    // K-mer pair span (only if paired-bruijn-graph=true)
            "--min-align-length=40",                 // [integer >=0] Min alignment length. Default: 40
            "--bloom-hash-functions=1",              // [integer >=0] Bloom filter hash functions. Default: 1
            "--kmer-count=2",                        // [integer >=0] K-mer count threshold. Default: 2
            "--save-graph=false"                     // [true, false] Save assembly graphs. Default: false
        ].join(' ')
    }

    // =================================================================
    // PHASE 5a: ASSEMBLY QUALITY ASSESSMENT (QUAST)
    // =================================================================
    withName: 'QUAST' {
        ext.outdir = '05_quast'
        ext.args = [
            "--genome-type=eukaryote",               // [prokaryote, eukaryote, large] Genome type. Default: eukaryote
            "--replace-non-atgc=true",               // [true, false] Replace non-ATGC with N. Default: true
            "--fragmented=false",                    // [true, false] Reference is fragmented. Default: false
            "--min-alignment=65",                    // [integer >=65] Min alignment length. Default: 65
            "--min-contig=500",                      // [integer >=65] Min contig length. Default: 500
            "--min-identity=95.0",                   // [float >=80.0] Min identity %. Default: 95.0
            "--ext-mis-size=1000",                   // [integer] Extensive misassembly threshold. Default: 1000
            "--local-mis-size=200"                   // [integer >=10] Local misassembly threshold. Default: 200
        ].join(' ')
    }

    // =================================================================
    // PHASE 5b: ASSEMBLY COMPLETENESS ASSESSMENT (BUSCO)
    // =================================================================
    withName: 'BUSCO' {
        ext.outdir = '05_busco'
        ext.args = [
            "--mode=genome",                         // [genome, transcriptome, proteins] Assessment mode
            "--blast-expect-value=1e-03"             // [enum] E-value threshold. Default: 1e-03
            // "--lineage=mammalia",                 // Lineage-specific BUSCO profile (optional)
        ].join(' ')
    }

    // =================================================================
    // PHASE 6: REPEAT MASKING
    // =================================================================
    withName: 'REPEATMASKER' {
        ext.outdir = '06_repeatmasker'
        ext.args = [
            "--speed-sensitivity=default",           // [default, -s, -q, -qq] Sensitivity level. Default: default
            "--masking-option=-xsmall",              // [-xsmall, default, -x] Masking type (soft/hard). Default: -xsmall
            "--apply-divergence-cutoff=false",       // [true, false] Apply divergence filter. Default: false
            // "--divergence-cutoff=80.0",           // [0-100] Divergence cutoff % (only if apply-divergence-cutoff=true)
            "--only-alus=false",                     // [true, false] Only mask Alus (primates). Default: false
            "--repeat-type=interspersed,simple_low", // [interspersed, simple_low] Repeat types to mask
            "--small-rna=false",                     // [true, false] Skip small RNA screening. Default: false
            // "--species=human"                     // Species for HMMER or RMBlast with Dfam Consensus (optional; improves sensitivity)
        ].join(' ')
    }

    // =================================================================
    // PHASE 7: EUKARYOTIC GENE FINDING (AUGUSTUS)
    // =================================================================
    withName: 'AUGUSTUS' {
        ext.outdir = '07_augustus'
        ext.args = [
            "--species=human",                       // Species for AUGUSTUS training
            "--strand=both",                         // [both, forward, backward] Strand to predict. Default: both
            "--gene-model=partial",                  // [partial, intronless, complete, atleastone, exactlyone] Gene model. Default: partial
            "--genomic-features=introns,start,stop", // Features to report in output GFF
            "--single-strand=false",                 // [true, false] Allow overlapping genes on opposite strands. Default: false
            "--utr=false",                           // [true, false] Predict UTRs (species-specific). Default: false
            "--softmasking=true",                    // [true, false] Handle soft-masked repeats. Default: false
            "--no-in-frame-stop-codons=false",       // [true, false] Exclude in-frame stop codons. Default: false
            "--stop-codon-excluded-from-cds=false",  // [true, false] Exclude stops from CDS. Default: false
            "--alt-from-sampling=false",             // [true, false] Report alternative transcripts. Default: false
            "--sample=100",                          // [integer >=0] Sampling iterations. Default: 100
            // "--min-exon-intron-prob=0.1",            // [0-1] Min exon/intron probability. Default: 0.1
            // "--min-mean-exon-intron-prob=0.4",       // [0-1] Min mean exon/intron probability. Default: 0.4
            // "--max-tracks=1",                     // [integer] Max alternative transcripts
            // "--temperature=3",                     // [0-7] Sampling temperature. Default: 3
            // ---------------------------------------------------------
            // Extrinsic Evidence Configuration (Uncomment ONLY if gene_finding_mode = 'ee'):
            // ---------------------------------------------------------
            // "--min-intron-length=41",             // [integer >=15] Min intron length for hints
            // "--max-intron-length=350000",         // [integer >=15] Max intron length for hints
            // "--allow-hinted-splice-sites=false",  // [true, false] Allow AT/AC splice sites
            // "--alt-from-evidence=false"           // [true, false] Report alternatives from evidence
        ].join(' ')
    }

    // =================================================================
    // PHASE 8a: FUNCTIONAL ANNOTATION (DIAMOND BLAST)
    // =================================================================
    withName: 'DIAMOND_BLAST' {
        ext.outdir = '08_diamond'
        ext.args = [
            "--blast-mode=blastx",                   // [blastx, blastp] Query mode. Default: blastx
            "--long-queries=false",                  // [true, false] Optimize for long sequences. Default: false
            "--blast-expect-value=1.0E-3",           // E-value threshold. Default: 1.0E-3
            "--number-of-hits=20",                   // [1-100] Max alignments. Default: 20
            "--blast-min-hsplength=33",              // [1-5000] Min HSP length. Default: 33
            "--hsp-hit-coverage-cutoff=0"            // [0-100] Min coverage %. Default: 0
        ].join(' ')
    }

    // =================================================================
    // PHASE 8b: FUNCTIONAL ANNOTATION (InterProScan)
    // =================================================================
    withName: 'CLOUD_INTERPROSCAN' {
        ext.outdir = '08_interproscan'
        ext.args = [
            // Configured via downstream interproscan module
        ].join(' ')
    }

    // =================================================================
    // PHASE 9: COMBINE PROJECTS (Merge Annotations)
    // =================================================================
    withName: 'COMBINE_PROJECTS' {
        ext.outdir = '09_combine_projects'
        ext.args = [
            // Configured via combine_projects module
        ].join(' ')
    }

    // =================================================================
    // PHASE 10: GENE ONTOLOGY MAPPING
    // =================================================================
    withName: 'GO_MAPPING' {
        ext.outdir = '10_go_mapping'
        ext.args = [
            // Configured via go_mapping module
        ].join(' ')
    }

    // =================================================================
    // PHASE 11: BLAST2GO ANNOTATION
    // =================================================================
    withName: 'BLAST2GO_ANNOTATION' {
        ext.outdir = '11_blast2go_annotation'
        ext.args = [
            // Configured via blast2go_annotation module
        ].join(' ')
    }

    // =================================================================
    // PHASE 12: MERGE InterProScan & GO ANNOTATIONS
    // =================================================================
    withName: 'MERGE_INTERPROSCAN_GO_ANNOTATION' {
        ext.outdir = '12_merge_annotations'
        ext.args = [
            // Configured via merge_annotations module
        ].join(' ')
    }
}
